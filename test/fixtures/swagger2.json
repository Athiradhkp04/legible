{
  "swagger": "2.0",
  "info": {
    "title": "Swagger 2.0 API",
    "version": "1.0.0",
    "description": "A Swagger 2.0 specification for testing"
  },
  "host": "api.example.com",
  "basePath": "/v1",
  "schemes": ["https"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "securityDefinitions": {
    "bearerAuth": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header"
    }
  },
  "paths": {
    "/users": {
      "get": {
        "operationId": "listUsers",
        "summary": "List users",
        "description": "Retrieve all users",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Max results",
            "type": "integer"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "type": "array",
              "items": { "type": "object" }
            }
          },
          "400": {
            "description": "Bad request",
            "schema": { "type": "object" }
          }
        }
      },
      "post": {
        "operationId": "createUser",
        "summary": "Create user",
        "description": "Create a new user",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "User data",
            "schema": { "type": "object" }
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "schema": { "type": "object" }
          }
        }
      }
    }
  }
}
